---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<!-- se modifica esta linea <BaseLayout sideBarActiveItemID="home">
  -->
<BaseLayout
  sideBarActiveItemID="home"
  title="Pedro David Reyes Pérez | Analista de datos"
  description="Portafolio de Pedro David Reyes Pérez, Data Analyst con experiencia en SQL, Python, Power BI, Excel y análisis de negocio."
>
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hola 👋</div>
    <!-- se modifica esta linea <div class="text-5xl font-bold">Soy Pedro David Reyes</div> -->
    <h1 class="text-5xl font-bold">Soy Pedro David Reyes</h1>
    <!-- se modifica esta linea <div class="text-3xl py-3 font-bold">Analista de Datos con visión de negocio</div>-->
    <h2 class="text-3xl py-3 font-bold">Analista de Datos con visión de negocio</h2>

<div class="py-2"> <text class="text-lg"> SQL · Python · Power BI · Excel </text> </div>      

    <div class="py-2">
      <text class="text-lg">
        Transformo datos en información clara que ayuda a tomar mejores decisiones.

Mi experiencia combina <b>tecnología, operaciones, hotelería y gestión de negocios</b>, lo que me permite analizar los datos no solo desde una perspectiva técnica, sino también entender su impacto en la operación y los resultados.
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="mailto:pedrodavidreyesperez+github@gmail.com?subject=Contacto%20desde%20tu%20portafolio" target="_blank">Contáctame por correo</a>
      <a href="https://pedrodavidreyes.github.io/cv/" target="_blank" class="btn btn-outline ml-5">Descargar CV</a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">Mis últimos proyectos {"</>"}</div>
  </div>

 <HorizontalCard
    title="📊 RappiPlus · De datos a decisiones de negocio"
    img="/Rappi.webp"
    desc="Análisis end-to-end de RappiPlus: evalué rentabilidad (11.5% margen neto), detecté una anomalía de $40M en costos, mapeé el funnel de conversión (49.5% final, con 18pp de fuga en checkout), medí retención por cohortes (de 86% a 40% en 4 semanas) y validé un experimento A/B en checkout. Resultados comunicados en un dashboard ejecutivo."
    url="https://github.com/pedrodavidreyes/Proyecto_De_datos_a_decisiones_de_negocio"
    badge="Nuevo"
    tags={["Python","SQL","Power BI","Rentabilidad","Funnel","Retención","A/B Testing"]}
  />
<div class="divider my-0"></div>
 <HorizontalCard
    title="🧪 Test A/B · Landing Page ecommerce"
    img="/testab.webp"
    desc="Validé estadísticamente un experimento A/B en landing page: la versión B superó a la A con +3.38pp de conversión y +43% de ingreso, validado estadísticamente con prueba t, Z y chi-cuadrada, sobre 40,000 usuarios."
    url="https://github.com/pedrodavidreyes/Proyecto_Experimento_A-B_en_Landing_Page"
    badge="Nuevo"
    tags={["Prueba t","Prueba Z","Chi-cuadrada","A/B Testing","Python","Jupyter Notebook"]}
  />
<div class="divider my-0"></div>
  <HorizontalCard
    title="📊 Dashboard de desempeño comercial · Andes Retail Group"
    img="/PBI_andes_1280x720.webp"
    desc="Construí un dashboard interactivo en Power BI que reveló que la caída de 6.8% en ventas de Andes Retail Group no era por pérdida de margen (35.1% estable), sino por una caída de 16.5% en ventas altas durante el verano."
    url="https://github.com/pedrodavidreyes/Proyecto_Dashboard_de_desempeno_comercial"
    tags={["Power BI","DAX","Power Query","Análisis comercial","Storytelling"]}
  />

  <div class="divider my-0"></div>
  <HorizontalCard
    title="🚦 Movilidad urbana y economía · Latam"
    img="/proyecto_5_pib_2024.webp"
    desc="Análisis de más de 1 millón de registros de movilidad de TomTom y datos económicos de OECD en 15 ciudades latinoamericanas. Con Python se identificó que congestión y PIB per cápita no presentan una relación directa, y se priorizó a Bogotá y Lima como candidatas para inversión en infraestructura por combinar alta congestión con menor productividad económica."
    url="https://github.com/pedrodavidreyes/Movilidad-Urbana-y-Economia"
    tags={["Python", "Pandas", "Seaborn", "Matplotlib", "Eda", "Jupyter Notebook"]}
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Artículos recientes del blog ✎</div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
