---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hola 👋</div>
    <div class="text-5xl font-bold">Soy Pedro David Reyes</div>
    <div class="text-3xl py-3 font-bold">Analista de Datos con visión de negocio</div>

<div class="py-2"> <text class="text-lg"> SQL · Python · Power BI · Excel </text> </div>      

    <div class="py-2">
      <text class="text-lg">
        Transformo datos en información clara que ayuda a tomar mejores decisiones.

Mi experiencia combina <b>tecnología, operaciones, hotelería y gestión de negocios</b>, lo que me permite analizar los datos no solo desde una perspectiva técnica, sino también entender su impacto en la operación y los resultados.
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="mailto:pedrodavidreyesperez+github@gmail.com?subject=Contacto%20desde%20tu%20portafolio" target="_blank">Contáctame por correo</a>
      <a href="https://pedrodavidreyes.github.io/cv/" target="_blank" class="btn btn-outline ml-5">Descargar CV</a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">Mis últimos proyectos {"</>"}</div>
  </div>

 <HorizontalCard
    title="📊 RappiPlus · De datos a decisiones de negocio"
    img="/Rappi.webp"
    desc="Análisis end-to-end de RappiPlus combinando Python, SQL y Power BI para evaluar rentabilidad, detectar anomalías, analizar funnel y retención, validar un experimento A/B y comunicar insights mediante storytelling ejecutivo en Power BI."
    url="https://github.com/pedrodavidreyes/Proyecto_De_datos_a_decisiones_de_negocio"
    badge="Nuevo"
    tags={["Python","SQL","Power BI","Rentabilidad","Funnel","Retención","A/B Testing"]}
  />
<div class="divider my-0"></div>
 <HorizontalCard
    title="🧪 Test A/B · Landing Page ecommerce"
    img="/testab.webp"
    desc="Validación estadística de un experimento A/B en página de inicio combinando prueba t de Student, prueba Z para dos proporciones y chi-cuadrada, para determinar qué versión maximiza conversión."
    url="https://github.com/pedrodavidreyes/Proyecto_Experimento_A-B_en_Landing_Page"
    badge="Nuevo"
    tags={["Prueba t","Prueba Z","Chi-cuadrada","A/B Testing","Python","Jupyter Notebook"]}
  />
<div class="divider my-0"></div>
  <HorizontalCard
    title="📊 Dashboard de desempeño comercial · Andes Retail Group"
    img="/PBI_andes_1280x720.webp"
    desc="Análisis interactivo en Power BI del desempeño comercial 2024–2025 en Perú, Chile y Colombia, enfocado en ventas, rentabilidad, segmentos de clientes y estacionalidad para detectar patrones y oportunidades de mejora."
    url="https://github.com/pedrodavidreyes/Embudo-y-retencion-MercadoLibre"
    tags={["Power BI","DAX","Power Query","Análisis comercial","Storytelling"]}
  />

  <div class="divider my-0"></div>
  <HorizontalCard
    title="🚦 Movilidad urbana y economía · Latam"
    img="/proyecto_5_pib_2024.webp"
    desc="Análisis exploratorio que evalúa la relación entre congestión vehicular y PIB per cápita para identificar ciudades prioritarias de inversión en infraestructura de transporte."
    url="https://github.com/pedrodavidreyes/Movilidad-Urbana-y-Economia"
    tags={["Python", "Pandas", "Seaborn", "Matplotlib", "Eda", "Jupyter Notebook"]}
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Artículos recientes del blog ✎</div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
