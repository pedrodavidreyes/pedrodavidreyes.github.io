---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title = "Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Proyectos de análisis de datos</div>
  </div>

 <HorizontalCard
    title="📊 RappiPlus · De datos a decisiones de negocio"
    img="/Rappi.webp"
    desc="Análisis end-to-end de RappiPlus: evalué rentabilidad (11.5% margen neto), detecté una anomalía de $40M en costos, mapeé el funnel de conversión (49.5% final, con 18pp de fuga en checkout), medí retención por cohortes (de 86% a 40% en 4 semanas) y validé un experimento A/B en checkout. Resultados comunicados en un dashboard ejecutivo."
    url="https://github.com/pedrodavidreyes/Proyecto_De_datos_a_decisiones_de_negocio"
    badge="Nuevo"
    tags={["Python","SQL","Power BI","Rentabilidad","Funnel","Retención","A/B Testing"]}
  />
<div class="divider my-0"></div>

  <HorizontalCard
    title="🧪 Test A/B · Landing Page ecommerce"
    img="/testab.webp"
    desc="Validé estadísticamente un experimento A/B en landing page: la versión B superó a la A con +3.38pp de conversión y +43% de ingreso, validado estadísticamente con prueba t, Z y chi-cuadrada, sobre 40,000 usuarios."
    url="https://github.com/pedrodavidreyes/Proyecto_Experimento_A-B_en_Landing_Page"
    badge="Nuevo"
    tags={["Prueba t","Prueba Z","Chi-cuadrada","A/B Testing","Python","Jupyter Notebook"]}
  />  
<div class="divider my-0"></div>
  <HorizontalCard
    title="📊 Dashboard de desempeño comercial · Andes Retail Group"
    img="/PBI_andes_1280x720.webp"
    desc="Construí un dashboard interactivo en Power BI que reveló que la caída de 6.8% en ventas de Andes Retail Group no era por pérdida de margen (35.1% estable), sino por una caída de 16.5% en ventas altas durante el verano."
    url="https://github.com/pedrodavidreyes/Proyecto_Dashboard_de_desempeno_comercial"
    tags={["Power BI","DAX","Power Query","Análisis comercial","Storytelling"]}
  />
<div class="divider my-0"></div>
<HorizontalCard
    title="🛒 Embudo y retención · MercadoLibre"
    img="/proyecto_4_embudo.webp"
    desc="Detecté que el 89% de la fuga en el funnel de Mercado Libre ocurre en select_item → add_to_cart (solo 11.0% avanza), y simulé que recuperar el 15% de ese abandono casi duplica la conversión final: de 1.3% a 2.4%."
    url="https://github.com/pedrodavidreyes/Embudo-y-retencion-MercadoLibre"
    tags={["Análisis de embudo", "Cohorte", "Conversión", "Retención", "Simulación", "Excel"]}
  />
  <div class="divider my-0"></div>
 <HorizontalCard
    title="🚦 Movilidad urbana y economía · Latam"
    img="/proyecto_5_pib_2024.webp"
    desc="Análisis de más de 1 millón de registros de movilidad de TomTom y datos económicos de OECD en 15 ciudades latinoamericanas. Con Python se identificó que congestión y PIB per cápita no presentan una relación directa, y se priorizó a Bogotá y Lima como candidatas para inversión en infraestructura por combinar alta congestión con menor productividad económica."
    url="https://github.com/pedrodavidreyes/Movilidad-Urbana-y-Economia"
    tags={["Python", "Pandas", "Seaborn", "Matplotlib", "Eda", "Jupyter Notebook"]}
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Desarrollo web</div>
  </div>
  <HorizontalCard
    title="💻 Website - Mallasombra del bajio"
    img="/mallasombra_1280x720.webp"
    desc="Rediseño integral de un sitio web que desarrollé años atrás, modernizando su imagen, estructura, contenido y experiencia para fortalecer confianza, claridad y conversión."
    url="https://mallasombradelbajio.com/"
    badge="Nuevo"
    tags={["Wordpress", "Divi", "Gimp", "Google Workspace"]}
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="💻 Website - Suites Malecón Cancún"
    img="/smc2026.webp"
    desc="Diseñe y desarrollé el sitio web de Suites Malecón Cancún, integrando un motor de reservas conectado al channel manager para disponibilidad y reservas en tiempo real."
    url="#"
    tags={["Wordpress", "Divi", "Siteminder", "Google Workspace"]}
  />
  <div class="divider my-0"></div>
</BaseLayout>
